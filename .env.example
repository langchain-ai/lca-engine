# Copy to .env and fill in your own values. Do NOT commit the real .env.

# LangSmith: Tracing and Observability
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=lca-engine
# Non-US region? Uncomment your endpoint (else your API key won't authenticate):
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com    # GCP EU
# LANGSMITH_ENDPOINT=https://apac.api.smith.langchain.com  # GCP APAC

# Optional: route ChatOpenAI through LangSmith LLM Gateway instead of OpenAI
# LANGSMITH_GATEWAY=true
# LANGSMITH_GATEWAY_API_KEY=lsv2_...

# Direct mode (default): use your actual OpenAI key; not required in gateway mode
OPENAI_API_KEY=your-openai-api-key
# ANTHROPIC_API_KEY=your-anthropic-api-key
# GOOGLE_API_KEY=your-google-api-key

# App-level config: default dataset for eval.py
DATASET_NAME=lca-engine-dataset